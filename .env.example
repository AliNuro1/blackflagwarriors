NEXT_PUBLIC_APP_URL=http://127.0.0.1:38471
# At least 32 characters. Used by iron-session (HttpOnly, SameSite=Lax, Secure in production).
SESSION_SECRET=replace-with-at-least-32-characters

# Server-only. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Verify (required in production). Never use NEXT_PUBLIC_ for these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Development-only. Forbidden in production. When true (or Twilio is unset in development),
# SMS is not sent and code 000000 is accepted. Production always uses Twilio Verify.
# AUTH_DEV_MOCK=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
